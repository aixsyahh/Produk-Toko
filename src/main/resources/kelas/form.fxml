<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="581.0" prefWidth="585.0" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="250.0" styleClass="header">
            <Label styleClass="title" text="Produk Toko" />
            <Button onAction="#handleLihatDaftar" text="Lihat Daftar" />
        </HBox>
    </top>
   <right>
        <ScrollPane fitToWidth="true" prefHeight="581.0" prefWidth="585.0" BorderPane.alignment="CENTER">
            <content>
                <VBox prefHeight="581.0" prefWidth="585.0" spacing="16" styleClass="page">
                    <VBox prefHeight="644.0" prefWidth="517.0" spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Tambah Produk" />
                        <Label text="Kode" />
                        <TextField fx:id="kodeField" promptText="Ketik disini" />
                        <Label text="Nama Produk" />
                        <TextField fx:id="namaField" promptText="Ketik disini" />
                        <Label text="Kategori" />
                        <ComboBox fx:id="KategoriCombo" maxWidth="1.7976931348623157E308" />
                  <Label layoutX="34.0" layoutY="143.0" text="Harga" />
                  <TextField fx:id="hargaField" layoutX="34.0" layoutY="171.0" promptText="Ketik disini" />
                  <Label layoutX="34.0" layoutY="301.0" text="Tambahkan foto produk (opsional)" />
                  <Button mnemonicParsing="false" onAction="#handlePilihFoto" text="Pilih Gambar" />
                  <ImageView fx:id="fotoImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                        <Button maxWidth="Infinity" onAction="#handleTambahProduk" styleClass="button-primary" text="Simpan" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
   </right>
</BorderPane>
