<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="581.0" prefWidth="585.0" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label styleClass="title" text="Daftar Produk" />
            <TextField fx:id="cariField" onAction="#cari" promptText="Cari nama produk " />
            <FlowPane hgap="20.0" vgap="8">
                <Button onAction="#cari" text="Cari" />
                <Button onAction="#tambah" styleClass="button-primary" text="Tambah" />
                <Button onAction="#detail" text="Lihat Detail" />
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columns>
                <TableColumn fx:id="kodeCol" prefWidth="100" text="Kode" />
                <TableColumn fx:id="namaCol" prefWidth="230" text="Nama" />
                <TableColumn fx:id="kategoriCol" prefWidth="150" text="Kategori" />
                <TableColumn fx:id="hargaCol" prefWidth="100" text="Harga" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
    </bottom>
</BorderPane>
