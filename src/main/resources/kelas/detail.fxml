<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="581.0" prefWidth="585.0" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController">
    <top>
        <HBox spacing="250.0" styleClass="header">
            <Label styleClass="title" text="Detail Produk" />
            <Button alignment="CENTER" contentDisplay="CENTER" onAction="#handleKembali" prefHeight="32.0" prefWidth="81.0" text="kembali" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox prefHeight="396.0" prefWidth="531.0" spacing="10" styleClass="card">
                  <ImageView fx:id="fotoImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="muted" text="Kode" />
                        <Label fx:id="kodeLabel" styleClass="subtitle" />
                        <Label styleClass="muted" text="Nama" />
                        <Label fx:id="namaLabel" wrapText="true" />
                        <Label styleClass="muted" text="Kategori" />
                        <Label fx:id="kategoriLabel" />
                        <Label styleClass="muted" text="Harga" />
                        <Label fx:id="hargaLabel" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
